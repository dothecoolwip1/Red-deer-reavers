{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.reddeerreavers.com"
        }
      ],
      "destination": "https://reddeerreavers.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "red-deer-reavers.vercel.app"
        }
      ],
      "destination": "https://reddeerreavers.com/:path*",
      "permanent": true
    },
    {
      "source": "/members-t.html",
      "destination": "/members.html",
      "permanent": false
    },
    {
      "source": "/members-t",
      "destination": "/members.html",
      "permanent": false
    },
    {
      "source": "/BuhurtOS",
      "destination": "https://buhurt-os.app/",
      "permanent": false
    },
    {
      "source": "/BuhurtOS/",
      "destination": "https://buhurt-os.app/",
      "permanent": false
    },
    {
      "source": "/BuhurtOS/:path+",
      "destination": "https://buhurt-os.app/:path+",
      "permanent": false
    },
    {
      "source": "/Red-deer-reavers",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Red-deer-reavers/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Red-deer-reavers/:path+",
      "destination": "/:path+",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/reavers-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/members",
      "destination": "/members.html"
    },
    {
      "source": "/agm",
      "destination": "/agm.html"
    }
  ]
}
