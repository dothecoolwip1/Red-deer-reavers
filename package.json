{
  "name": "red-deer-reavers-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "check": "node scripts/check-static.mjs",
    "check:js": "node --check app.js && node --check admin.js && node --check team-data.js && node --check buhurtos.js && node --check fighter.js && node --check gallery.js && node --check sw.js",
    "lighthouse": "lhci autorun",
    "a11y": "pa11y-ci --config .pa11yci.json",
    "pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/grenze-gotisch": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "add-to-calendar-button": "3.1.1",
    "photoswipe": "5.4.4",
    "qrcode": "1.5.4",
    "sharp": "0.35.4",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "pa11y-ci": "4.1.1"
  }
}
